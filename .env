# ==========================================
# CONFIGURACIÓN DEL ENTORNO
# ==========================================
NODE_ENV=production

# ==========================================
# URL DEL BACKEND (API GATEWAY / BFF)
# ==========================================
# Para desarrollo local (Docker/PC):
# NEXT_PUBLIC_API_URL=http://localhost:8084/api/v1
#
NEXT_PUBLIC_API_URL=http://TU_IP_PUBLICA_O_DOMINIO/api/v1

# ==========================================
# CONFIGURACIÓN DE AZURE AD (MSAL)
# ==========================================

# El ID de la aplicación (Client ID) de tu frontend en Azure
NEXT_PUBLIC_AZURE_CLIENT_ID=tu-client-id-aqui

# El ID del inquilino (Tenant ID) de tu directorio en Azure
NEXT_PUBLIC_AZURE_TENANT_ID=tu-tenant-id-aqui

# La URL a la que Azure redirige después del login exitoso
# En local es http://localhost:3000, pero en producción será tu dominio real
NEXT_PUBLIC_AZURE_REDIRECT_URI=http://TU_IP_PUBLICA_O_DOMINIO_DEL_FRONTEND