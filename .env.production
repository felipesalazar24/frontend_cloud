# 1. Pega aquí la Invoke URL que te dio tu nuevo API Gateway (con /api/v1 al final)
NEXT_PUBLIC_API_URL=https://vtfhilb6xc.execute-api.us-east-1.amazonaws.com/api/v1

# 2. Apunta al nuevo API Gateway (o a http://a9fa4075eca9d4c5b83e088d0a105a49-759450356.us-east-1.elb.amazonaws.com)
NEXT_PUBLIC_BFF_URL=https://vtfhilb6xc.execute-api.us-east-1.amazonaws.com

# 3. Se mantiene intacto
NEXT_PUBLIC_AZURE_CLIENT_ID=a4d3e345-3a3d-45e3-a248-a07a76da5e1b
NEXT_PUBLIC_AZURE_TENANT_ID=7022b65e-3fa4-4c19-b7ca-db8663f34a71

# 4. Si corres el front en local sin Cloudflare, usa localhost:3000 (o la URL donde lo tengas corriendo)
